;FOLD STARTPOSITION - BASE IS 0, TOOL IS 5, SPEED IS 15%, POSITION IS A1 5,A2 -90,A3 100,A4 5,A5 -10,A6 -5,E1 0,E2 0,E3 0,E4 0
